# =============================================================================
# Local development.
#
# Copy this file to `.env.local` and fill it in:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored. This file is committed, so it must never hold a
# real value. For a production server use `.env.production.example` instead.
#
# Everything here is validated at startup by `lib/env.ts` — if a value is
# missing or malformed the server refuses to boot and tells you which one.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — signs the session cookie (see lib/auth/session.ts).
#
# At least 32 characters. Generate a fresh one:
#
#     openssl rand -base64 32
#
# Changing it invalidates every session that is currently signed in.
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — base URL of nisir-backend-php, which serves the catalogue, auth
# and orders. The browser never sees this; only server code calls it.
#
# May include a path prefix (https://api.example.com/v1) — it is preserved.
#
# 8000 is where `php artisan serve` puts it. Start the backend first:
#
#     cd ../nisir-backend-php && php artisan serve
#
# then `npm run dev` here, which takes 3000. If you point this at the wrong
# port nothing warns you at startup — the URL is only checked for shape — and
# the first symptom is the store failing to render with "Could not reach
# nisir-backend".
# -----------------------------------------------------------------------------
NISIR_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# OPTIONAL — canonical origin for metadataBase, Open Graph and canonical links
# (see lib/site.ts). Defaults to https://nisirdesigns.com.
#
# NEXT_PUBLIC_ means this one is compiled into the browser bundle at build time
# rather than read at runtime, so it must be correct when you run `next build`,
# and it must never hold anything secret.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
