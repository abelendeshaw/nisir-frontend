# =============================================================================
# Production template.
#
# On the server, copy this to `.env.production.local` beside the app and fill
# it in:
#
#     cp .env.production.example .env.production.local
#     chmod 600 .env.production.local
#
# Why that filename: Next reads env files in a fixed order and stops at the
# first hit —
#
#     process.env  >  .env.production.local  >  .env.local  >  .env.production  >  .env
#
# `.env.production.local` wins over everything on disk, so a stray `.env.local`
# left over from a laptop copy cannot quietly override production. It is also
# gitignored, like every `.env*` except the two `.example` templates.
#
# If your host has a UI for environment variables, that is better still: real
# process environment variables beat every file, and nothing sensitive sits on
# disk. Either way `lib/env.ts` validates these at startup and refuses to boot
# on a bad value.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — signs the session cookie.
#
# Generate a NEW one for production:
#
#     openssl rand -base64 32
#
# Do not reuse the development secret. Anyone holding it can forge a signed-in
# session for this site. Rotating it signs everybody out, which is exactly what
# you want if it ever leaks.
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — base URL of nisir-backend.
#
# Must be https:// unless the backend runs on this same machine, in which case
# loopback (http://127.0.0.1:3000) is fine and stays off the network. Plaintext
# http to any other host is rejected at startup: every signed-in request replays
# the backend access token on this connection as a Bearer header.
# -----------------------------------------------------------------------------
NISIR_API_URL=https://api.nisirdesigns.com

# -----------------------------------------------------------------------------
# Canonical public origin — the address visitors actually type.
#
# Compiled into the browser bundle at BUILD time, not read at runtime, so it has
# to be set before `npm run build` and a change means rebuilding. Get it wrong
# and share cards and canonical links point at the wrong host.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nisirdesigns.com

# -----------------------------------------------------------------------------
# Runtime knobs for the standalone server (`npm run start:standalone`).
#
# PORT is the port Node listens on. On shared hosting the panel usually assigns
# this for you — leave it unset there and let the platform inject it.
# HOSTNAME 0.0.0.0 accepts connections from outside the machine; 127.0.0.1 takes
# only local ones, which is what you want when a reverse proxy sits in front.
# -----------------------------------------------------------------------------
# PORT=3000
# HOSTNAME=127.0.0.1

# NODE_ENV is set to production automatically by `next build` and `next start`.
# Set it explicitly only if your host starts the app in some other way.
# NODE_ENV=production
